# ========================================================
# YouTube Music API Configuration Example
# Made by Yuvi
# ========================================================

# Server Port (default: 5000)
PORT=5000

# --------------------------------------------------------
# YouTube Cookies Configuration
# --------------------------------------------------------
# Place your exported YouTube cookies in 'cookies.txt' in the project root,
# OR paste the raw cookies text directly into YOUTUBE_COOKIES below:
COOKIES_FILE=cookies.txt
# YOUTUBE_COOKIES=

# --------------------------------------------------------
# Security & Access Control
# --------------------------------------------------------
# Direct Running: Set to false to allow direct access without API keys.
REQUIRE_API_KEY=false
API_KEY=Made by Yuvi

# --------------------------------------------------------
# Optional Proxy
# --------------------------------------------------------
# PROXY_URL=http://user:pass@host:port
